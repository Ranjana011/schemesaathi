# Copy this file to ".env" and fill in your real values. Never commit the real .env file.

# Your MongoDB Atlas connection string (from Atlas → Connect → Drivers)
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/scheme_saathi?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/scheme_saathi?retryWrites=true&w=majority

# Any long random string — used to sign login sessions (JWTs)
JWT_SECRET=change_this_to_a_long_random_string

# Port this auth server runs on (separate from Flask's 5000)
PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend URLs)
CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173
